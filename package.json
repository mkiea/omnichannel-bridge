{
  "name": "omnichannel-bridge",
  "version": "0.1.0",
  "description": "全渠道桥：把同一个角色接到多个平台（QQ / B 站 / …）的双向桥。宿主无关——DSH 只是最方便的一个适配，也可接任意 agent 框架。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkiea/omnichannel-bridge.git"
  },
  "homepage": "https://github.com/mkiea/omnichannel-bridge#readme",
  "bugs": {
    "url": "https://github.com/mkiea/omnichannel-bridge/issues"
  },
  "bin": {
    "qq-control": "./control/bin/qq-control.mjs"
  },
  "scripts": {
    "control": "node control/bin/qq-control.mjs",
    "test": "node test/control-unit.mjs",
    "test:all": "node tools/test-all.mjs",
    "host-guard": "node tools/host-guard.mjs",
    "gate": "node tools/module-gate.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./extension": "./lib/extension.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "control",
    "test",
    "docs",
    "launcher",
    "scripts",
    "一键启动.bat",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "keywords": [
    "bridge",
    "omnichannel",
    "multi-platform",
    "relay",
    "onebot",
    "onebot11",
    "milky",
    "qq",
    "bilibili",
    "bili",
    "im",
    "chatbot",
    "agent",
    "character",
    "persona",
    "companion",
    "dsh",
    "host-agnostic",
    "self-hosted"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "supportedRuntimeLines": [
      "0.1",
      "0.2"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "silk-wasm": "^3.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
